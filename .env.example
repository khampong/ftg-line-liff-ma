# Database
DATABASE_URL="postgresql://forklift:forklift@localhost:5432/forklift_repair?schema=public"

# JWT (auth หลังบ้าน)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# LINE
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_LOGIN_CHANNEL_ID=""
NEXT_PUBLIC_LIFF_ID=""

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="5"

# Cloudflare R2 (สำหรับ Production / Vercel)
# หากระบุครบ 4 ตัวนี้ ระบบจะเปลี่ยนไปเก็บรูปที่ R2 อัตโนมัติ (ถ้าเว้นว่างจะเก็บลง UPLOAD_DIR ในเครื่อง)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# โฟลเดอร์ใน R2 Bucket เช่น "attachments" หรือ "uploads" (เว้นว่างได้ถ้าต้องการเก็บไว้ที่ root)
R2_FOLDER=""

# Public URL ของแอป (ใช้สร้าง LIFF URL ใน QR)
PUBLIC_BASE_URL="http://localhost:3000"
